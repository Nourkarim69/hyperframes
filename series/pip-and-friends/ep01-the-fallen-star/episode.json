          "face": -1,
          "emo": "happy",
          "glow": 1.3,
          "scale": 0.4
        }
      },
      "beats": [
        {
          "say": "narrator",
          "text": "And from that night on, whenever Pip looked up at the sky...",
          "do": {
            "twinkle": {
              "gest": "bounce"
            }
          }
        },
        {
          "say": "narrator",
          "text": "one little star always twinkled back, just for him.",
          "cam": "twinkle",
          "sfx": ["chime"],
          "fx": [["sparkles", "twinkle", 1.4]]
        },
        {
          "say": "pip",
          "text": "Goodnight, Twinkle.",
          "cam": "pip",
          "do": {
            "pip": {
              "emo": "sleepy",
              "gest": "wave"
            }
          }
        },
        {
          "say": "narrator",
          "text": "Because sometimes, the best way to help a friend... is to share a little joy.",
          "cam": "wide",
          "wait": 5.0
        }
      ]
    }
  ],
