      "beats": [
        {
          "say": "pip",
          "text": "Then let's fill your heart all the way up! Ready, Hazel?",
          "do": {
            "pip": {
              "gest": "bounce"
            }
          }
        },
        {
          "say": "pip",
          "text": "Twinkle, Twinkle, little star, you're our friend, that's what you are!",
          "cam": "pip",
          "do": {
            "pip": {
              "gest": "cheer",
              "emo": "happy"
            },
            "hazel": {
              "gest": "bounce"
            }
          }
        },
        {
          "say": "hazel",
          "text": "Up above the woods so high, go back home and light the sky!",
          "cam": "hazel",
          "do": {
            "hazel": {
              "gest": "cheer",
              "emo": "happy"
            },
            "pip": {
              "gest": "spin"
            },
            "twinkle": {
              "glow": 1.4,
              "emo": "excited"
            }
          },
          "fx": [["sparkles", "twinkle", 1.4]]
        },
        {
          "say": "twinkle",
          "text": "I feel so light! I'm floating!",
          "cam": "wide",
          "sfx": ["chime"],
          "do": {
            "twinkle": {
              "move": [1080, 380],
              "time": 2.0,
              "emo": "excited"
            },
            "pip": {
              "look": "twinkle",
              "emo": "surprised"
            },
            "hazel": {
              "look": "twinkle",
              "emo": "surprised"
            }
          },
          "fx": [["trail", "twinkle", 2.0]]
        },
        {
          "say": "twinkle",
          "text": "Thank you, Pip! Thank you, Hazel! I'll never forget you!",
          "do": {
            "twinkle": {
              "move": [1300, -350],
              "time": 3.2
            },
            "pip": {
              "emo": "happy",
              "gest": "wave"
            },
            "hazel": {
              "emo": "happy",
              "gest": "wave"
            }
          },
          "fx": [
            ["trail", "twinkle", 3.2],
            ["flash", 3.4]
          ],
          "wait": 3.4,
          "sfx": ["sparkle"]
        }
      ]
    },
    {
