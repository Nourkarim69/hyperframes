          "glow": 1.3,
          "scale": 0.4
        }
      },
      "beats": [
        {
          "say": "narrator",
          "text": "That night, Pip went home tired, but very, very happy.",
          "do": {
            "twinkle": {
              "gest": "bounce"
            }
          }
        },
        {
          "say": "narrator",
          "text": "And up in the sky, one little star twinkled just for him.",
          "cam": "twinkle",
          "sfx": ["chime"],
          "fx": [["sparkles", "twinkle", 1.4]]
        },
        {
          "say": "pip",
          "text": "Goodnight, Twinkle. Goodnight, Mittens.",
          "cam": "pip",
          "do": {
            "pip": {
              "emo": "sleepy",
              "gest": "wave"
            }
          },
          "wait": 4.0
        }
      ]
    }
  ],
